# ─────────────────────────────────────────────────────────────────
# IHMA hujjat tizimi — muhit sozlamalari
# Bu faylni ".env" deb nusxalang va qiymatlarni to'ldiring.
# ".env" faylini GIT'ga QO'SHMANG (u .gitignore da).
# ─────────────────────────────────────────────────────────────────

# Ishlab chiqishda True, serverda ALBATTA False
DJANGO_DEBUG=True

# Maxfiy kalit. Yangisini yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Serverda majburiy. Vergul bilan ajrating.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS orqali ishlatilsa (nginx orqasida) — CSRF uchun
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ihma.uz,https://www.ihma.uz

# HTTPS yoqilgan bo'lsa True qiling: HSTS, xavfsiz cookie, HTTPS ga yo'naltirish
DJANGO_HTTPS=False

# Baza fayli joyi (ixtiyoriy)
# DJANGO_DB_PATH=/var/lib/ihma/db.sqlite3

# Shablonlar papkasi (ixtiyoriy — sukut bo'yicha loyiha ichidagi Shablons/)
# SHABLONLAR_ROOT=/var/lib/ihma/Shablons

# Sessiya muddati (soniya). Sukut: 12 soat
# DJANGO_SESSION_AGE=43200

# Loglash
DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_FAYLGA=True
